{
  "name": "dsh-skillswitch",
  "version": "0.1.1",
  "description": "Skill switch for DeepSeek Harness: list every installed skill, turn one off so it truly leaves the model catalog and the skill tool, or uninstall a skill you installed yourself.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-management"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lrht-llw/dsh-skillswitch.git"
  },
  "homepage": "https://github.com/Lrht-llw/dsh-skillswitch#readme",
  "bugs": {
    "url": "https://github.com/Lrht-llw/dsh-skillswitch/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
